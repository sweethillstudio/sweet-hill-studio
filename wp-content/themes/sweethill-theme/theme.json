{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Sweet Hill Studio - Oryzo Aesthetic Pivot (Dark Mode)",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "860px",
      "wideSize": "1400px"
    },
    "color": {
      "custom": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "dark-obsidian",
          "color": "#0A0A0B",
          "name": "Dark Obsidian Canvas"
        },
        {
          "slug": "dark-surface",
          "color": "#121316",
          "name": "Dark Surface"
        },
        {
          "slug": "dark-card",
          "color": "#1A1B20",
          "name": "Dark Card Surface"
        },
        {
          "slug": "dark-card-hover",
          "color": "#242630",
          "name": "Dark Card Hover"
        },
        {
          "slug": "bright-ink",
          "color": "#FDFBF7",
          "name": "Bright Ink"
        },
        {
          "slug": "muted-ink",
          "color": "#A0A0A8",
          "name": "Muted Ink"
        },
        {
          "slug": "vibrant-orange",
          "color": "#FF5500",
          "name": "Vibrant Orange"
        },
        {
          "slug": "vibrant-green",
          "color": "#0FA958",
          "name": "Vibrant Green"
        },
        {
          "slug": "gold-accent",
          "color": "#E5A93C",
          "name": "Vedic Gold Accent"
        },
        {
          "slug": "border-dark",
          "color": "#24262E",
          "name": "Subtle Dark Border"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "Pure White"
        },
        {
          "slug": "warm-beige",
          "color": "#121316",
          "name": "Dark Surface (legacy alias)"
        },
        {
          "slug": "soft-cream",
          "color": "#1A1B20",
          "name": "Dark Card (legacy alias)"
        },
        {
          "slug": "warm-ivory",
          "color": "#0A0A0B",
          "name": "Dark Obsidian (legacy alias)"
        },
        {
          "slug": "soft-parchment",
          "color": "#121316",
          "name": "Dark Surface (legacy alias)"
        },
        {
          "slug": "charcoal",
          "color": "#FDFBF7",
          "name": "Bright Ink (legacy alias)"
        },
        {
          "slug": "deep-ink",
          "color": "#FDFBF7",
          "name": "Bright Ink (legacy alias)"
        },
        {
          "slug": "warm-sand",
          "color": "#24262E",
          "name": "Dark Border (legacy alias)"
        },
        {
          "slug": "muted-earth",
          "color": "#A0A0A8",
          "name": "Muted Ink (legacy alias)"
        }
      ],
      "gradients": [
        {
          "slug": "dark-fade",
          "gradient": "linear-gradient(180deg, #0A0A0B 0%, #121316 100%)",
          "name": "Dark Fade"
        },
        {
          "slug": "orange-glow",
          "gradient": "radial-gradient(circle, rgba(255,85,0,0.2) 0%, rgba(10,10,11,0) 70%)",
          "name": "Orange Glow"
        },
        {
          "slug": "green-glow",
          "gradient": "radial-gradient(circle, rgba(15,169,88,0.18) 0%, rgba(10,10,11,0) 70%)",
          "name": "Green Glow"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFamily": "\"Newsreader\", \"Cormorant Garamond\", \"Georgia\", serif",
          "name": "Editorial Serif",
          "slug": "editorial-serif",
          "fontFace": [
            {
              "fontFamily": "Newsreader",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/newsreader/Newsreader-VariableFont_opsz,wght.woff2"]
            },
            {
              "fontFamily": "Newsreader",
              "fontWeight": "400 700",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/newsreader/Newsreader-Italic-VariableFont_opsz,wght.woff2"]
            }
          ]
        },
        {
          "fontFamily": "\"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
          "name": "Interface Sans",
          "slug": "interface-sans",
          "fontFace": [
            {
              "fontFamily": "Plus Jakarta Sans",
              "fontWeight": "300 800",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/plus-jakarta-sans/PlusJakartaSans-VariableFont_wght.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "name": "Caption",
          "size": "0.8rem",
          "slug": "caption",
          "fluid": {
            "min": "0.75rem",
            "max": "0.85rem"
          }
        },
        {
          "name": "Small",
          "size": "0.95rem",
          "slug": "small",
          "fluid": {
            "min": "0.875rem",
            "max": "1rem"
          }
        },
        {
          "name": "Body",
          "size": "1.125rem",
          "slug": "body",
          "fluid": {
            "min": "1.0625rem",
            "max": "1.25rem"
          }
        },
        {
          "name": "H4 / Subsection",
          "size": "1.75rem",
          "slug": "h4",
          "fluid": {
            "min": "1.35rem",
            "max": "2.25rem"
          }
        },
        {
          "name": "H3 / Eyebrow Heading",
          "size": "2.5rem",
          "slug": "h3",
          "fluid": {
            "min": "1.85rem",
            "max": "3.25rem"
          }
        },
        {
          "name": "H2 / Section Title",
          "size": "3.75rem",
          "slug": "h2",
          "fluid": {
            "min": "2.5rem",
            "max": "4.75rem"
          }
        },
        {
          "name": "H1 / Hero Title",
          "size": "5.5rem",
          "slug": "h1",
          "fluid": {
            "min": "3.25rem",
            "max": "6.5rem"
          }
        },
        {
          "name": "Massive Display / Kinetic Type",
          "size": "8rem",
          "slug": "display",
          "fluid": {
            "min": "4.5rem",
            "max": "9.5rem"
          }
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 0,
        "defaultSpacingSizes": false
      },
      "spacingSizes": [
        {
          "name": "20 (Micro)",
          "size": "clamp(0.5rem, 0.4rem + 0.4vw, 0.75rem)",
          "slug": "20"
        },
        {
          "name": "30 (Compact)",
          "size": "clamp(0.875rem, 0.75rem + 0.5vw, 1.25rem)",
          "slug": "30"
        },
        {
          "name": "40 (Standard)",
          "size": "clamp(1.25rem, 1rem + 1vw, 1.75rem)",
          "slug": "40"
        },
        {
          "name": "50 (Medium)",
          "size": "clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem)",
          "slug": "50"
        },
        {
          "name": "60 (Large)",
          "size": "clamp(2.5rem, 2rem + 2vw, 4rem)",
          "slug": "60"
        },
        {
          "name": "70 (XL / Section)",
          "size": "clamp(4rem, 3rem + 3.5vw, 6.5rem)",
          "slug": "70"
        },
        {
          "name": "80 (XXL / Viewport)",
          "size": "clamp(6rem, 4.5rem + 5vw, 10rem)",
          "slug": "80"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Oryzo Dark Subtle Shadow",
          "shadow": "0 8px 30px rgba(0, 0, 0, 0.45)",
          "slug": "subtle"
        },
        {
          "name": "Elevated Dark Glowing Surface",
          "shadow": "0 20px 48px rgba(0, 0, 0, 0.7), 0 0 1px rgba(255, 255, 255, 0.12)",
          "slug": "elevation"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|dark-obsidian",
      "text": "var:preset|color|bright-ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|interface-sans",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.65"
    },
    "spacing": {
      "padding": {
        "left": "var:preset|spacing|40",
        "right": "var:preset|spacing|40"
      },
      "blockGap": "var:preset|spacing|40"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|editorial-serif",
          "fontWeight": "700",
          "lineHeight": "0.98",
          "letterSpacing": "-0.03em"
        },
        "color": {
          "text": "var:preset|color|bright-ink"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|h1",
          "lineHeight": "0.94"
        },
        "color": {
          "text": "var:preset|color|bright-ink"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|h2",
          "lineHeight": "0.98"
        },
        "color": {
          "text": "var:preset|color|bright-ink"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|h3",
          "lineHeight": "1.08"
        },
        "color": {
          "text": "var:preset|color|bright-ink"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|h4",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "var:preset|color|bright-ink"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|bright-ink"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|vibrant-orange"
          },
          "typography": {
            "textDecoration": "none"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|vibrant-orange",
          "text": "var:preset|color|white"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|interface-sans",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600",
          "letterSpacing": "0.06em",
          "textTransform": "uppercase"
        },
        "border": {
          "radius": "100px"
        },
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|30",
            "bottom": "var:preset|spacing|30",
            "left": "var:preset|spacing|60",
            "right": "var:preset|spacing|60"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|vibrant-green",
            "text": "var:preset|color|white"
          }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var:preset|font-family|interface-sans",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        },
        "color": {
          "text": "var:preset|color|bright-ink"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|editorial-serif",
          "letterSpacing": "-0.02em"
        },
        "color": {
          "text": "var:preset|color|bright-ink"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|border-dark"
        },
        "border": {
          "color": "var:preset|color|border-dark"
        }
      }
    }
  }
}
