{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Sweet Hill Studio",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1320px"
    },
    "color": {
      "custom": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "warm-ivory",
          "color": "#FDFBF7",
          "name": "Warm Ivory"
        },
        {
          "slug": "soft-parchment",
          "color": "#F4EFEA",
          "name": "Soft Parchment"
        },
        {
          "slug": "off-white",
          "color": "#FAF8F5",
          "name": "Off White"
        },
        {
          "slug": "ink",
          "color": "#121316",
          "name": "Ink"
        },
        {
          "slug": "charcoal",
          "color": "#2C2D30",
          "name": "Deep Charcoal"
        },
        {
          "slug": "muted-earth",
          "color": "#7C756E",
          "name": "Muted Earth"
        },
        {
          "slug": "terracotta",
          "color": "#B8532F",
          "name": "Terracotta Accent"
        },
        {
          "slug": "gold-ochre",
          "color": "#C9944A",
          "name": "Gold Ochre"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFamily": "\"Newsreader\", \"Cormorant Garamond\", \"Georgia\", serif",
          "name": "Editorial Serif",
          "slug": "editorial-serif",
          "fontFace": [
            {
              "fontFamily": "Newsreader",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/newsreader/Newsreader-VariableFont_opsz,wght.woff2"]
            },
            {
              "fontFamily": "Newsreader",
              "fontWeight": "400 700",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/newsreader/Newsreader-Italic-VariableFont_opsz,wght.woff2"]
            }
          ]
        },
        {
          "fontFamily": "\"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
          "name": "Interface Sans",
          "slug": "interface-sans",
          "fontFace": [
            {
              "fontFamily": "Plus Jakarta Sans",
              "fontWeight": "300 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/plus-jakarta-sans/PlusJakartaSans-VariableFont_wght.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "name": "Caption",
          "size": "0.75rem",
          "slug": "caption",
          "fluid": {
            "min": "0.75rem",
            "max": "0.825rem"
          }
        },
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small",
          "fluid": {
            "min": "0.825rem",
            "max": "0.95rem"
          }
        },
        {
          "name": "Body",
          "size": "1.0625rem",
          "slug": "body",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "name": "H4 / Subsection",
          "size": "1.25rem",
          "slug": "h4",
          "fluid": {
            "min": "1.15rem",
            "max": "1.35rem"
          }
        },
        {
          "name": "H3 / Section Eyebrow",
          "size": "1.5rem",
          "slug": "h3",
          "fluid": {
            "min": "1.35rem",
            "max": "1.85rem"
          }
        },
        {
          "name": "H2 / Major Heading",
          "size": "2rem",
          "slug": "h2",
          "fluid": {
            "min": "1.75rem",
            "max": "2.5rem"
          }
        },
        {
          "name": "H1 / Page Title",
          "size": "2.75rem",
          "slug": "h1",
          "fluid": {
            "min": "2.25rem",
            "max": "3.5rem"
          }
        },
        {
          "name": "Display / Hero",
          "size": "4rem",
          "slug": "display",
          "fluid": {
            "min": "2.75rem",
            "max": "5rem"
          }
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 0,
        "defaultSpacingSizes": false
      },
      "spacingSizes": [
        {
          "name": "20 (Micro)",
          "size": "clamp(0.5rem, 0.4rem + 0.4vw, 0.75rem)",
          "slug": "20"
        },
        {
          "name": "30 (Compact)",
          "size": "clamp(0.875rem, 0.75rem + 0.5vw, 1.25rem)",
          "slug": "30"
        },
        {
          "name": "40 (Standard)",
          "size": "clamp(1.25rem, 1rem + 1vw, 1.75rem)",
          "slug": "40"
        },
        {
          "name": "50 (Medium)",
          "size": "clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem)",
          "slug": "50"
        },
        {
          "name": "60 (Large)",
          "size": "clamp(2.5rem, 2rem + 2vw, 4rem)",
          "slug": "60"
        },
        {
          "name": "70 (XL / Section)",
          "size": "clamp(4rem, 3rem + 3.5vw, 6.5rem)",
          "slug": "70"
        },
        {
          "name": "80 (XXL / Viewport)",
          "size": "clamp(6rem, 4.5rem + 5vw, 10rem)",
          "slug": "80"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Subtle Surface Elevation",
          "shadow": "0 4px 20px rgba(18, 19, 22, 0.04)",
          "slug": "subtle"
        },
        {
          "name": "Elevated Modal / Dropdown",
          "shadow": "0 12px 32px rgba(18, 19, 22, 0.08)",
          "slug": "elevation"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|warm-ivory",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|interface-sans",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.65"
    },
    "spacing": {
      "padding": {
        "left": "var:preset|spacing|40",
        "right": "var:preset|spacing|40"
      },
      "blockGap": "var:preset|spacing|40"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|editorial-serif",
          "fontWeight": "600",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "var:preset|color|ink"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|h1",
          "lineHeight": "1.15"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|h2",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|h3",
          "lineHeight": "1.25"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|h4",
          "lineHeight": "1.3"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|terracotta"
          },
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|ink",
          "text": "var:preset|color|warm-ivory"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|interface-sans",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        },
        "border": {
          "radius": "2px"
        },
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|30",
            "bottom": "var:preset|spacing|30",
            "left": "var:preset|spacing|50",
            "right": "var:preset|spacing|50"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|charcoal"
          }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var:preset|font-family|interface-sans",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "500",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|editorial-serif"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|soft-parchment"
        },
        "border": {
          "color": "var:preset|color|soft-parchment"
        }
      }
    }
  }
}
